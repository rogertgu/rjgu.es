{
  "name": "rjgu.es",
  "version": "2.0.0",
  "private": true,
  "description": "Web personal de Rogert Guevara (rjgu.es): sitio estático sin paso de build",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "validate": "node scripts/validate.mjs",
    "lint:html": "html-validate _site/index.html _site/404.html _site/en _site/cutrepodcast",
    "test": "node scripts/build-site.mjs && playwright test",
    "check": "npm run validate && npm run lint:html && npm test",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1 --directory _site"
  },
  "author": "Rogert Guevara Uzcátegui",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "html-validate": "^11.4.0"
  }
}
